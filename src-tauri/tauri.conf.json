{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SqlStudio",
  "version": "0.1.0",
  "identifier": "com.karamuklu.sqlstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SqlStudio",
        "width": 1280,
        "height": 820,
        "minWidth": 860,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "Modern SQL Server desktop studio",
    "longDescription": "A modern Windows-first SQL Server desktop management application."
  }
}

