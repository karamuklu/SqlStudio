{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SqlStudio",
  "version": "0.2.0",
  "identifier": "com.karamuklu.sqlstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SqlStudio",
        "width": 1280,
        "height": 820,
        "minWidth": 860,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "Modern SQL Server desktop studio",
    "longDescription": "A modern Windows-first SQL Server desktop management application."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4MTE0NkQ2QTIxNjlFMkMKUldRc25oYWkxa1lSS0h4UGt2S04rRTN1WCtDbDB6NE9vWVc5aUxWWXB0SG02YmJ4UFVSNStNMloK",
      "endpoints": [
        "https://github.com/karamuklu/SqlStudio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

